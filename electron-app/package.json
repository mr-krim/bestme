{
  "name": "bestme-electron",
  "version": "0.1.0",
  "description": "BestMe - Modern Speech-to-Text Application (Electron)",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "npm run build:renderer && cross-env NODE_ENV=development electron .",
    "dev:quick": "electron .",
    "build:renderer": "cd renderer && npm run build",
    "build": "npm run build:renderer && electron-builder",
    "dist": "npm run build",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "speech-to-text",
    "whisper",
    "electron",
    "transcription",
    "ai"
  ],
  "author": "BestMe Team",
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "electron-store": "^10.1.0",
    "mic": "^2.1.2",
    "wav": "^1.0.2"
  },
  "build": {
    "appId": "com.bestme.desktop",
    "productName": "BestMe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/dist/**/*",
      "models/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}